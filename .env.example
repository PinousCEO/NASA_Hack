# Copy to .env (git-ignored). Secrets are read from the environment only.
# OPENAI_API_KEY=               # enables model-based analysis, planning, code generation and text-to-3D
# OPENAI_MODEL=gpt-5.5          # any chat model your key can use
# ANTHROPIC_API_KEY=            # alternative provider (used when OPENAI_API_KEY is not set)
# MISSION_AI_MODEL=claude-opus-5-5
# LLM_PROVIDER=                 # force "openai" or "anthropic" when both keys are present
# GMAT_BIN=                     # path to a GMAT console executable (enables gmat.run)
# PDFTOTEXT_BIN=                # path to pdftotext (PDF ingestion for the knowledge base)
# HOST=0.0.0.0                  # listen on the LAN (headsets); requires TLS for WebXR
# PORT=8787
# TLS_CERT_FILE=                # PEM certificate
# TLS_KEY_FILE=                 # PEM private key
# ALLOWED_ORIGINS=http://localhost:3000   # frontend dev server origin(s), comma separated
