# Copy to .env (git-ignored). Every value here is read by the SERVER only; nothing in this file
# reaches the browser bundle. Do not put real keys in this file, in the repository, or in chat.
#
# Nothing below is required to start the game. Without a language-model key the crew can still
# play (parts, lines, launch, flight, scoring), but "My AI" falls back to a small rule-based
# analyser that understands only a few fixed phrasings and cannot write control logic.

# ---- Language model for "My AI" (one provider is enough) ---------------------------------------
# SECRET. Billed by the provider per request. Enables: free-form questions, hypotheses, building
# parts and lines from a sentence, writing control logic, mission briefs, text-to-3D.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra        # any chat model the key can use (structured output required)
# OPENAI_BASE_URL=                # optional: an OpenAI-compatible endpoint
# ANTHROPIC_API_KEY=              # SECRET. Alternative provider, used when OPENAI_API_KEY is not set
# MISSION_AI_MODEL=claude-opus-5-5
# LLM_PROVIDER=                   # force "openai" or "anthropic" when both keys are present

# ---- Serving ----------------------------------------------------------------------------------
# HOST=0.0.0.0                    # listen on the LAN so a headset can connect (default 127.0.0.1)
# PORT=8787
# TLS_CERT_FILE=                  # PEM certificate. WebXR on a headset needs HTTPS (localhost is exempt)
# TLS_KEY_FILE=                   # SECRET file path. PEM private key
# ALLOWED_ORIGINS=http://localhost:3000   # extra browser origins allowed to call the API (web dev server)

# ---- Storage ----------------------------------------------------------------------------------
# MISSION_DATA_DIR=               # accounts, sessions, mission versions, audit log (default ./.data)
# MISSION_CACHE_DIR=              # cached NASA terrain and imagery tiles (default ./.data/cache)

# ---- Optional tools ---------------------------------------------------------------------------
# GMAT_BIN=                       # path to a GMAT console executable (enables the gmat.run capability)
# PDFTOTEXT_BIN=                  # path to pdftotext (lets the knowledge base read the PDFs in Data/)

# ---- Web client build (apps/web) --------------------------------------------------------------
# PUBLIC (compiled into the browser bundle). Only needed when the web client is served from a
# different origin than the server; leave unset when the server serves the built client itself.
# NEXT_PUBLIC_CORE_ORIGIN=

# NASA data (JPL Horizons, GIBS imagery, Moon/Mars Trek, PDS terrain) is public and needs no key.
